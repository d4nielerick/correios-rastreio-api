{
  "name": "correios-rastreio-api",
  "version": "1.0.0",
  "description": "Microserviço autônomo, rápido e leve para consulta e rastreamento de encomendas dos Correios sem necessidade de contrato.",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsup src/server.ts --format esm --clean --out-dir dist && cp -r src/public dist/public 2>/dev/null || true",
    "start": "NODE_ENV=production node dist/server.js",
    "test": "NODE_ENV=test node --import tsx --test tests/*.test.ts"
  },
  "keywords": [
    "correios",
    "rastreio",
    "tracking",
    "encomendas",
    "pac",
    "sedex",
    "fastify",
    "api",
    "brasil"
  ],
  "author": "Daniel Erick",
  "license": "MIT",
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/static": "^7.0.4",
    "dotenv": "^16.4.5",
    "fastify": "^4.28.1",
    "lru-cache": "^10.4.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.9",
    "pino-pretty": "^11.2.1",
    "tsup": "^8.1.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
